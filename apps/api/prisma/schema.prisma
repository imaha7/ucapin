generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PricingMode {
  MANUAL
  AUTOMATIC
}

enum TemplateTier {
  FREE
  STANDARD
  PREMIUM
}

enum InvitationStatus {
  DRAFT
  UNPAID
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
}

enum AttendanceStatus {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         UserRole     @default(USER)
  invitations  Invitation[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Template {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  category    String
  description String
  imageUrl    String
  pricingMode PricingMode  @default(MANUAL)
  basePrice   Decimal      @default(0) @db.Decimal(12, 2)
  tier        TemplateTier @default(STANDARD)
  isActive    Boolean      @default(true)
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PricingRule {
  id               String   @id @default(cuid())
  name             String
  baseCustomPrice  Decimal  @default(50000) @db.Decimal(12, 2)
  pricePerSection  Decimal  @default(15000) @db.Decimal(12, 2)
  extraMediaPrice  Decimal  @default(10000) @db.Decimal(12, 2)
  customAudioPrice Decimal  @default(20000) @db.Decimal(12, 2)
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model Invitation {
  id              String             @id @default(cuid())
  ownerId         String
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  templateId      String?
  template        Template?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  slug            String             @unique
  title           String
  content         Json
  calculatedPrice Decimal            @default(0) @db.Decimal(12, 2)
  status          InvitationStatus   @default(DRAFT)
  publishedAt     DateTime?
  expiresAt       DateTime?
  transaction     PaymentTransaction?
  rsvps           Rsvp[]
  guestWishes     GuestWish[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model PaymentTransaction {
  id              String        @id @default(cuid())
  invitationId    String        @unique
  invitation      Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  gatewayReference String?      @unique
  snapToken       String?
  checkoutUrl     String?
  status          PaymentStatus @default(PENDING)
  expiresAt       DateTime
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Rsvp {
  id             String           @id @default(cuid())
  invitationId   String
  invitation     Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestName      String
  attendance     AttendanceStatus
  guestCount     Int              @default(1)
  message        String?
  createdAt      DateTime         @default(now())

  @@index([invitationId, createdAt])
}

model GuestWish {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestName    String
  message      String
  isApproved   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([invitationId, isApproved, createdAt])
}
